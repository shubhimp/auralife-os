{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start AuraLife Server",
      "type": "shell",
      "command": "${command:python.interpreterPath} main.py",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run AuraLife CLI",
      "type": "shell",
      "command": "${command:python.interpreterPath} main.py --cli",
      "problemMatcher": []
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "${command:python.interpreterPath} main.py --test",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Export Data",
      "type": "shell",
      "command": "${command:python.interpreterPath} main.py --export",
      "problemMatcher": []
    }
  ]
}
